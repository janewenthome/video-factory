{
  "version": "gui-contract.v2",
  "source_picker": "folder",
  "profiles": ["family", "health_education"],
  "duration_presets": ["short", "standard", "full", "custom"],
  "music_modes": ["auto_open_licensed", "project_music", "local_licensed", "none"],
  "review_modes": ["AUTO", "REVIEW", "MANUAL"],
  "default_review_mode": "AUTO",
  "quality_modes": ["standard", "deep"],
  "advanced": ["privacy_mode", "cloud_perception", "gpu_policy", "temporal_backend", "music_license_policy"],
  "progress_messages": [
    "正在理解影片內容",
    "正在分析語音",
    "正在整理相似畫面",
    "正在尋找精彩片段",
    "正在分析配樂需求",
    "正在尋找適合的公開授權配樂",
    "正在確認配樂授權",
    "正在準備配樂",
    "請先檢查剪輯摘要"
  ],
  "application_service": "video_editor.application.VideoFactoryApplication",
  "source_summary_method": "inspect_source",
  "queue": {
    "service": "video_editor.application.VideoFactoryQueue",
    "max_parallel_jobs": 1,
    "statuses": ["pending", "running", "completed", "failed", "cancelled"],
    "controls": ["add", "start_all", "pause", "resume", "cancel_one", "reorder"],
    "progress_events": [
      "queue_job_added",
      "queue_progress",
      "queue_job_started",
      "queue_job_process_started",
      "queue_job_process_completed",
      "queue_job_process_cancelled",
      "queue_job_cancel_requested",
      "queue_reordered",
      "queue_paused",
      "queue_resumed",
      "queue_finished"
    ],
    "resource_gate": {
      "provider": "macOS memory_pressure",
      "default_cooldown_seconds": 45,
      "default_recheck_seconds": 30,
      "pause_when_unavailable": true
    }
  }
}
